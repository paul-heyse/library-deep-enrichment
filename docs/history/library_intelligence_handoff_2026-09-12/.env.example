# Copy to .env after selecting and smoke-testing an immutable official image.
# Populate the real digest; the placeholder below is not a usable image.
# VLLM_IMAGE=vllm/vllm-openai@sha256:<tested-image-digest>

# Absolute host path to an explicitly acquired Qwen/Qwen3-Embedding-8B snapshot.
# The directory must contain the model config, tokenizer and all weight shards.
# QWEN_MODEL_DIR=/absolute/path/to/pinned-qwen3-embedding-8b-snapshot
