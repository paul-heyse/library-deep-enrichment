# direnv configuration. Run `direnv allow` once after cloning.
#
# Interactive shells get the same environment the agent harness gets from
# scripts/hooks/session_env.sh: both source scripts/env.sh, so they cannot drift.

export LDE_ROOT="$PWD"
# shellcheck source=scripts/env.sh
source_env scripts/env.sh

# Personal, machine-local overrides (gitignored).
source_env_if_exists .envrc.local

watch_file rust-toolchain.toml
watch_file pyproject.toml
watch_file uv.lock
